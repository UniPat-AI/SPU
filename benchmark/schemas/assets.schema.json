{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assets": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "path", "sha256", "size_bytes", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"},
          "role": {"enum": ["input", "verification", "provenance"]},
          "path": {"type": "string", "minLength": 3, "maxLength": 240},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "source": {
            "oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "local"}}},
              {"type": "object", "additionalProperties": false, "required": ["kind", "repo_id", "revision", "file"], "properties": {"kind": {"const": "huggingface"}, "repo_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "file": {"type": "string", "minLength": 1}}},
              {"type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": {"kind": {"const": "https"}, "url": {"type": "string", "maxLength": 2048}}}
            ]
          }
        }
      }
    }
  }
}
