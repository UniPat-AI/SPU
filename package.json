{
  "name": "spu",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Science Prediction Universe: task contribution templates, submissions and PR checks",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:example": "node scripts/validate.mjs examples/synthetic",
    "quality": "node scripts/quality.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check": "npm run check:source && npm test && npm run validate:example"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
